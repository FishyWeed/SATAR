# Copy this file to .env and fill in the values from your Supabase project.
# Project URL: Project Settings > Data API (or the Connect button).
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...), or the legacy anon key: Project Settings > API Keys.
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
# Secret key (sb_secret_...), or the legacy service_role key. Server only: lets the Administrator invite users.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key
# Connect > Transaction pooler (port 6543). Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres
